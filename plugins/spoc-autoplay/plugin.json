{
  "id": "spoc-autoplay",
  "name": "SPOC 刷课",
  "version": "2.1.0",
  "description": "自动爬取 spoc.bnu.edu.cn 课程学习内容页的全部视频(经章节 API 精确筛选),多线程倍速刷课;以页面完成度为准判定完成,前端展示每线程进度与预计完成时间;Cookie 缓存免登录,支持统一身份认证 CAS 登录。",
  "entry": "plugin.py",
  "config_schema": [
    {
      "key": "study_urls",
      "label": "学习内容页链接",
      "type": "string-list",
      "hint": "一行一个课程 studycontent 页 URL,刷该课全部视频;留空则遍历全部已选课程"
    },
    {
      "key": "only_unfinished",
      "label": "只刷未完成视频",
      "type": "bool",
      "default": true
    },
    {
      "key": "workers",
      "label": "并发浏览器数",
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 16
    },
    {
      "key": "speedup",
      "label": "播放倍速",
      "type": "number",
      "default": 3.0,
      "min": 1,
      "max": 16
    },
    {
      "key": "headless",
      "label": "无头模式",
      "type": "bool",
      "default": true
    },
    {
      "key": "username",
      "label": "统一认证账号(留空用全局)",
      "type": "string",
      "default": ""
    },
    {
      "key": "password",
      "label": "统一认证密码(留空用全局)",
      "type": "password",
      "default": ""
    }
  ]
}
