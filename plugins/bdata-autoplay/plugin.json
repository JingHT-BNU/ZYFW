{
  "id": "bdata-autoplay",
  "name": "师道云刷课",
  "version": "2.1.2",
  "description": "支持师道云刷课与答题互动：可并行播放必修视频，也可调用兼容 OpenAI Chat 接口的模型生成测验答案、课程评论和回复，并在用户确认后提交；课程量表可按固定策略或正态分布自动选择。",
  "entry": "plugin.py",
  "config_ui": "ui.html",
  "config_schema": [
    {
      "key": "task_mode",
      "label": "任务类型",
      "type": "choice",
      "default": "study",
      "choices": ["study", "qa"],
      "choice_labels": ["刷课", "答题与互动"]
    },
    {
      "key": "course_urls",
      "label": "课程链接",
      "type": "string-list",
      "hint": "一行一个师道云课程 URL，例如 https://bdata.bnu.edu.cn/course?cid=..."
    },
    {
      "key": "only_unfinished",
      "label": "只刷未完成视频",
      "type": "bool",
      "default": true
    },
    {
      "key": "workers",
      "label": "并发浏览器数",
      "type": "number",
      "default": 2,
      "min": 1,
      "step": 1,
      "hint": "每个浏览器进程独立播放一个视频；并发数按任务数量和本机资源设置"
    },
    {
      "key": "speedup",
      "label": "播放倍速",
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 3,
      "step": 0.5,
      "hint": "实测高于 3 倍时服务器记录不稳定"
    },
    {
      "key": "completion_tolerance",
      "label": "完成容差(秒)",
      "type": "number",
      "default": 3,
      "min": 0,
      "max": 30,
      "step": 1,
      "hint": "服务器记录时长距视频总时长不超过该秒数或 1% 时视为完成"
    },
    {
      "key": "survey_strategy",
      "label": "量表答题策略",
      "type": "choice",
      "default": "fixed",
      "choices": ["fixed", "normal"],
      "choice_labels": ["固定正负策略", "正态分布策略"]
    },
    {
      "key": "survey_positive_value",
      "label": "正向题固定选项",
      "type": "choice",
      "default": "3",
      "choices": ["0", "1", "2", "3", "4"],
      "choice_labels": ["非常不同意", "不同意", "一般", "同意", "非常同意"]
    },
    {
      "key": "survey_negative_value",
      "label": "负向题固定选项",
      "type": "choice",
      "default": "1",
      "choices": ["0", "1", "2", "3", "4"],
      "choice_labels": ["非常不同意", "不同意", "一般", "同意", "非常同意"]
    },
    {
      "key": "headless",
      "label": "无头模式",
      "type": "bool",
      "default": true
    },
    {
      "key": "username",
      "label": "统一认证账号(留空用全局)",
      "type": "string",
      "default": ""
    },
    {
      "key": "password",
      "label": "统一认证密码(留空用全局)",
      "type": "password",
      "default": ""
    },
    {
      "key": "api_url",
      "label": "模型 API 地址",
      "type": "string",
      "default": "https://api.deepseek.com"
    },
    {
      "key": "api_key",
      "label": "模型 API Key",
      "type": "password",
      "default": ""
    },
    {
      "key": "model_id",
      "label": "模型 ID",
      "type": "string",
      "default": "deepseek-flash"
    }
  ]
}
